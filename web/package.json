{
  "name": "@gameplane/web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:compile && tsc -b && vite build",
    "i18n:extract-only": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"src/**/*.test.{ts,tsx}\" --ignore \"src/**/*.d.ts\" --ignore \"src/generated/**\" --out-file src/generated/i18n/extracted.json",
    "i18n:extract": "npm run i18n:extract-only && node scripts/i18n-reference.mjs",
    "i18n:compile": "node scripts/i18n-compile.mjs",
    "i18n:fixtures": "node scripts/i18n-fixtures.mjs",
    "i18n:pseudo": "node scripts/i18n-pseudo.mjs",
    "i18n:migrate": "node scripts/i18n-migrate.ts",
    "i18n:manifest": "cd ../i18n && go run ./cmd/i18n-check --manifest ../web/src/generated/i18n/languages.json locales",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage",
    "test:e2e:mock": "GAMEPLANE_E2E_TARGET=mock playwright test",
    "test:e2e:live": "GAMEPLANE_E2E_TARGET=live playwright test",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "screenshots": "GAMEPLANE_E2E_TARGET=mock GAMEPLANE_SCREENSHOTS=1 playwright test",
    "screenshots:design": "GAMEPLANE_E2E_TARGET=mock GAMEPLANE_SCREENSHOTS=1 playwright test e2e/screenshots",
    "screenshots:pseudo": "GAMEPLANE_E2E_TARGET=mock GAMEPLANE_SCREENSHOTS=1 VITE_I18N_PSEUDO=1 playwright test e2e/screenshots",
    "diff:screenshots": "node scripts/compare-screenshots.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@monaco-editor/react": "^4.7.0",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-virtual": "^3.14.20",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.34",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-formatjs": "^8.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "pixelmatch": "^8.0.0",
    "postcss": "^8.5.30",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "vitest-websocket-mock": "^0.8.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

{
	"containerEnv": {
		"CI": "1",
		"GAMEPLANE_REG_HOST_PORT": "5001",
		"GOTOOLCHAIN": "local"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"1yib.rust-bundle",
				"ahmedsaid.darkpinkpro",
				"anthropic.claude-code",
				"bradlc.vscode-tailwindcss",
				"dbaeumer.vscode-eslint",
				"dustypomerleau.rust-syntax",
				"esbenp.prettier-vscode",
				"fill-labs.dependi",
				"golang.go",
				"google.gemini-cli-vscode-ide-companion",
				"google.geminicodeassist",
				"highagency.pencildev",
				"ms-azuretools.vscode-containers",
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"ms-vscode.makefile-tools",
				"nicolasdschmidt.lunar-pink",
				"redhat.vscode-yaml",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"vue.volar"
			],
			"settings": {
				"[go]": {
					"editor.defaultFormatter": "golang.go"
				},
				"[typescript]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"[typescriptreact]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"editor.formatOnSave": true,
				"go.toolsManagement.checkForUpdates": "off",
				"go.useLanguageServer": true,
				"vs-kubernetes": {
					"vs-kubernetes.crd-code-completion": "enabled"
				},
				"workbench.browser.openLocalhostLinks": false,
				"workbench.colorTheme": "Lunar Pink"
			}
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"configureZshAsDefaultShell": "false",
			"installZsh": "true",
			"username": "vscode"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"dockerDashComposeVersion": "v2",
			"moby": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/go:1": {
			"version": "1.27.3"
		},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"helm": "4.3.1",
			"minikube": "none",
			"version": "1.36"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24"
		}
	},
	"forwardPorts": [
		5173,
		8080,
		8443,
		5001,
		30565
	],
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
	"name": "Gameplane \u00b7 Full",
	"portsAttributes": {
		"30565": {
			"label": "Sample Minecraft NodePort",
			"onAutoForward": "silent"
		},
		"5001": {
			"label": "Local OCI registry",
			"onAutoForward": "silent"
		},
		"5173": {
			"label": "Vite (web dev)",
			"onAutoForward": "notify"
		},
		"8080": {
			"label": "Gameplane ingress (HTTP)",
			"onAutoForward": "silent"
		},
		"8443": {
			"label": "Gameplane ingress (HTTPS)",
			"onAutoForward": "silent"
		}
	},
	"postCreateCommand": "bash .devcontainer/setup.sh .devcontainer/full/setup.env",
	"remoteUser": "vscode",
	"runArgs": [
		"--init"
	]
}

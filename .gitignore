# Go
/bin/
/dist/
*.test
*.out
*.prof
coverage.*
# Audit component-review coverage table (spec 018 contracts/audit-records.md), not test coverage output
!specs/*/audit/coverage.md
# Spec 018 OD-019: unfixed security findings stay off GitHub until their fix merges
specs/*/audit/held/
coverage/
vendor/
operator/bin/
test/e2e/.kube/

# Node / web
/node_modules/
web/node_modules/
web/node_modules
web/dist/
web/.vite/
web/.turbo/
web/coverage/
web/playwright-report/
web/test-results/
web/website-screenshots/
# Generated i18n artifacts (compiled catalogs, extracted messages, language manifest)
web/src/generated/
# Registry snapshot written by `make i18n-sync` and consumed by i18n-check
i18n/.registry.json
# Condition ids and used-id list written by `make check-i18n` (spec 019)
i18n/.condition-ids.txt
i18n/.used-ids.txt
# Filtered language packs written by i18n-check --valid-out for the dashboard build
i18n/.valid/
web/e2e/.portforward.pid
*.log
.npmrc.local

# Editor / OS
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.DS_Store
Thumbs.db
*.swp
*~

# Env / secrets
.env
.env.*
!.env.example

              "strokeAlignment": "inner",
              "layout": "vertical",
              "gap": 6,
              "padding": [
                16,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "BPXtv",
                  "name": "Note",
                  "fill": "$foreground/muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "All figures are approximate and self-reported. Reports are anonymous; extended reports are signed by a key the install derives locally, which stops impersonation but not invented installs.",
                  "lineHeight": 1.5,
                  "fontFamily": "$typography/font-sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "N1Jwcs",
                  "name": "Note",
                  "fill": "$foreground/muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Install IDs are stored only as keyed hashes. Activity records expire 90 days after an install's last report, and daily aggregates are kept for 24 months. No IP address or raw report is stored.",
                  "lineHeight": 1.5,
                  "fontFamily": "$typography/font-sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]

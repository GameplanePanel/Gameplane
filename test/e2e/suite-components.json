    { "tests": "^TestGameTemplate_", "components": ["operator", "api", "agent"] },
    { "tests": "^(TestModule_|TestModuleSource)", "components": ["operator", "api", "modules"] },
    { "tests": "^TestModule_FinalizerBlocksWhileTemplateInUse$", "components": ["agent"] },

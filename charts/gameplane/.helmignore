# Files that stay in Git but are not packaged into the chart. Keeping them out
# keeps the packaged chart small enough to embed (for example in a k3s
# HelmChart's spec.chartContent, which must fit Kubernetes' 256 KiB annotation
# limit when applied client-side).
.helmignore
# CI-only render fixtures and test scripts.
testdata/
tests/
# Dev container dependency list, read by hack/need.sh from the repository.
system-deps.toml
# The CRD subchart stays in Git (it is published on its own as
# gameplane-crds) but is not part of this chart: the crd-apply hook installs
# the same CRDs from crd-manifests/, so bundling both doubled the package.
charts/

FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
WORKDIR /src

# tunnel's go.mod currently has no gameaction requirement (no local
# replace directive), so this COPY is a no-op for the build. It is kept
# only for structural parity with sentinel/Dockerfile, api/Dockerfile, and
# agent/Dockerfile, which do depend on gameaction.
COPY gameaction/ ./gameaction/
COPY tunnel/go.mod tunnel/go.sum* ./tunnel/
WORKDIR /src/tunnel
RUN go mod download

WORKDIR /src
COPY tunnel/ ./tunnel/
WORKDIR /src/tunnel

ARG VERSION=dev
# Cross-compile on the build host ($BUILDPLATFORM above) rather than under
# QEMU emulation: multi-arch release builds of the arm64 image were slow
# enough to hit the release job timeout.
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/tunnel .

# Build frpc from source instead of using the upstream release binary: the
# release binaries ship an older Go toolchain, golang.org/x/net and
# golang.org/x/crypto with fixed HIGH CVEs that the image scan rejects
# (spec 013 G2, T031). tunnel/frpc/go.mod pins frp and the newer x/net and
# x/crypto; go.sum makes the download checksum-verified. The noweb tag leaves
# out frpc's admin web UI, which the supervisor never enables (it runs frpc
# with only a rendered config file).
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS frp-stage
WORKDIR /src/frpc
COPY tunnel/frpc/go.mod tunnel/frpc/go.sum ./
RUN go mod download
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} GOFLAGS=-mod=readonly go build \
    -trimpath \
    -ldflags="-s -w" \
    -tags frpc,noweb \
    -o /out/frpc github.com/fatedier/frp/cmd/frpc

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=build /out/tunnel /tunnel
COPY --from=frp-stage /out/frpc /usr/local/bin/frpc
USER 65532:65532
EXPOSE 25565/tcp 25565/udp
ENTRYPOINT ["/tunnel"]

FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine AS build
WORKDIR /src

# tunnel's go.mod currently has no gameaction requirement (no local
# replace directive), so this COPY is a no-op for the build. It is kept
# only for structural parity with sentinel/Dockerfile, api/Dockerfile, and
# agent/Dockerfile, which do depend on gameaction.
COPY gameaction/ ./gameaction/
COPY tunnel/go.mod tunnel/go.sum* ./tunnel/
WORKDIR /src/tunnel
RUN go mod download

WORKDIR /src
COPY tunnel/ ./tunnel/
WORKDIR /src/tunnel

ARG VERSION=dev
# Cross-compile on the build host ($BUILDPLATFORM above) rather than under
# QEMU emulation: multi-arch release builds of the arm64 image were slow
# enough to hit the release job timeout.
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/tunnel .

# Build stage to download and verify playit binary
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS playit-stage
ARG PLAYIT_VERSION=1.0.10
ARG TARGETARCH
ARG PLAYIT_SHA256_amd64=2df7d9f10227ab312b1ad341853db4e8a8243df5cfcdbae58713a4271711c339
ARG PLAYIT_SHA256_aarch64=4c0db3e7b3a8158e249441c2f0b73f54e83429395890c7b1ca45fd7a6303d763

RUN apk add --no-cache curl~=8.23.0
WORKDIR /tmp
# DL4006: fail the RUN if any command in a pipe fails.
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
RUN mkdir -p /out && \
    if [ "$TARGETARCH" = "arm64" ]; then \
      PLAYIT_ARCH="aarch64"; \
      PLAYIT_SHA256="$PLAYIT_SHA256_aarch64"; \
    else \
      PLAYIT_ARCH="amd64"; \
      PLAYIT_SHA256="$PLAYIT_SHA256_amd64"; \
    fi && \
    curl -fsSL "https://github.com/playit-cloud/playit-agent/releases/download/v${PLAYIT_VERSION}/playit-linux-${PLAYIT_ARCH}" \
    -o playit && \
    echo "${PLAYIT_SHA256}  playit" | sha256sum -c - && \
    mv playit /out/playitd && \
    chmod +x /out/playitd

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=build /out/tunnel /tunnel
COPY --from=playit-stage /out/playitd /usr/local/bin/playitd
USER 65532:65532
EXPOSE 25565/tcp 25565/udp
EXPOSE 8091/tcp
ENTRYPOINT ["/tunnel"]

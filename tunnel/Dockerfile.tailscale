FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
WORKDIR /src

# tunnel's go.mod currently has no gameaction requirement (no local
# replace directive), so this COPY is a no-op for the build. It is kept
# only for structural parity with sentinel/Dockerfile, api/Dockerfile, and
# agent/Dockerfile, which do depend on gameaction.
COPY gameaction/ ./gameaction/
COPY tunnel/go.mod tunnel/go.sum* ./tunnel/
WORKDIR /src/tunnel
RUN go mod download

WORKDIR /src
COPY tunnel/ ./tunnel/
WORKDIR /src/tunnel

ARG VERSION=dev
# Cross-compile on the build host ($BUILDPLATFORM above) rather than under
# QEMU emulation: multi-arch release builds of the arm64 image were slow
# enough to hit the release job timeout.
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/tunnel .

# Copy tailscale binaries from the official upstream image pinned by digest.
# tailscale is distributed as official OCI images; pinning by digest
# ensures reproducible builds. The image ships both tailscaled and tailscale CLI.
FROM tailscale/tailscale:v1.104.2@sha256:b11583ad2e93e4671128538c88cf11f460444a5d7e449311dd1933a400ab849d AS tailscale-stage

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=build /out/tunnel /tunnel
COPY --from=tailscale-stage /usr/local/bin/tailscaled /usr/local/bin/tailscaled
COPY --from=tailscale-stage /usr/local/bin/tailscale /usr/local/bin/tailscale
USER 65532:65532
EXPOSE 25565/tcp 25565/udp
ENTRYPOINT ["/tunnel"]
